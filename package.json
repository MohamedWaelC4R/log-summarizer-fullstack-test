{
  "name": "log-summarizer-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Summarize a plain-text log as JSON: CLI, Express API and a React UI",
  "main": "src/summarize.js",
  "scripts": {
    "cli": "node src/cli.js samples/sample.log",
    "start": "node src/server.js",
    "dev:server": "node --watch src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --test \"test/**/*.test.js\"",
    "install:all": "npm install && npm --prefix client install"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "express": "^5.1.0" }
}
